{
  // One hosting config, deployed to a different site depending on which
  // Firebase project it is deployed against. `.firebaserc` maps the `web`
  // deploy target per project (see docs/WEB_HOSTING_TOPOLOGY.md):
  //
  //   komodo-wallet-official -> site walletrc              (CI, push to `dev`)
  //   komodo-wallet-preview  -> site komodo-wallet-preview (local default)
  //   gleec-wallet-official  -> site gleec-wallet-official (dex.gleec.com,
  //                                                         deployed by hand)
  //
  //   firebase deploy --only hosting:web --project <project>
  //
  // `web` names the ROLE ("the wallet web app site for this project"), not a
  // site. Do not name it after any one site: the target is shared across
  // projects, so a site-shaped name is wrong everywhere except one place.
  // `--project` is what selects the site, so always pass it -- a bare
  // `firebase deploy` uses `.firebaserc`'s default, which is the preview
  // project on purpose, and a bare `firebase deploy --project
  // gleec-wallet-official` publishes whatever is in build/web to production.
  //
  // Production being the SAME config rather than a second entry is the point:
  // dex.gleec.com serves the fiat on-ramp wrapper page that desktop and mobile
  // builds already in users' hands fetch at runtime, so it must never end up
  // with weaker headers than the release candidate. A second entry would have
  // to be kept in step by hand; one entry cannot drift.
  "hosting": {
    "target": "web",
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    // DO NOT enable this block. `credentialless` strips the cross-origin
    // cookies that the fiat provider KYC flow documents as required, so
    // turning it on silently breaks identity verification part-way through a
    // purchase.
    // "headers": [
    //   {
    //     "source": "**",
    //     "headers": [
    //       {
    //         "key": "Cross-Origin-Embedder-Policy",
    //         "value": "credentialless"
    //       },
    //       {
    //         "key": "Cross-Origin-Opener-Policy",
    //         "value": "same-origin"
    //       }
    //     ]
    //   }
    // ],
    "headers": [
      {
        // Each glob below owns a distinct set of header keys, so no key is
        // ever set by two entries. Firebase applies the headers of every
        // matching entry, so the security headers here still reach the paths
        // that the narrower globs below also match.
        "source": "**",
        "headers": [
          {
            // The wallet is only ever framed by itself (the web build renders
            // the fiat wrapper page in a same-origin iframe).
            // `frame-ancestors` is the header that actually governs this;
            // X-Frame-Options is kept alongside it for clients that predate
            // CSP Level 2.
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            // Only features that neither the wallet nor the fiat providers
            // use. `camera`, `microphone`, `payment`, `encrypted-media` and
            // `midi` are deliberately absent: their default allowlist is
            // `self`, which is exactly what lets the fiat wrapper page
            // delegate them to the provider iframe via its `allow` attribute.
            // Denying them here would break provider KYC.
            "key": "Permissions-Policy",
            "value": "geolocation=(), usb=(), serial=(), bluetooth=(), idle-detection=()"
          }
        ]
      },
      {
        // Coin icons are a large, rarely-changing set (hundreds of files).
        // Without this they inherit Firebase's default max-age=3600, so every
        // repeat visit more than an hour apart re-validates the whole set while
        // the user is logging in.
        //
        // Flutter web assets are not content-hashed, so this is a bounded TTL
        // rather than `immutable`. Note that AssetIcon's bundled -> CDN ->
        // fallback chain does NOT rescue a stale icon: it only triggers when an
        // asset is missing, and a cached-but-outdated file still loads fine.
        // The TTL is the whole mitigation, so re-arting an existing icon can
        // take up to 30 days to propagate. Adding an icon under a new filename
        // is unaffected. If an in-place icon change ever needs to ship fast,
        // shorten this value or rename the file.
        "source": "/assets/packages/komodo_defi_framework/assets/coin_icons/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        // These pages decide what a webview is allowed to load, and desktop
        // and mobile builds fetch them from here rather than from their own
        // bundle. Firebase's default max-age=3600 would leave already-shipped
        // clients running a superseded copy for up to an hour after a fix is
        // deployed, so require revalidation instead; a 304 on a page loaded
        // once per purchase costs nothing.
        "source": "/assets/assets/web_pages/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
