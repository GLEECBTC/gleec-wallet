# Copy to .env and fill in. `.env` is gitignored.
#
# ── GasFree upstream credentials (REPLACE THESE) ─────────────────────────────
# The real api_key / api_secret for the GasFree account behind the Gleec proxy.
# These are the only genuinely sensitive values here. For a connectivity-only
# test (steps 1-2 in the README) any non-empty placeholder works, because the
# 401 happens at the proxy's libp2p gate, before the GasFree HMAC is ever used.
GASFREE_API_KEY=replace-with-gasfree-api-key
GASFREE_API_SECRET=replace-with-gasfree-api-secret

# Upstream the proxy forwards /gasfree to. Default is the public GasFree API.
GASFREE_OUTBOUND_URL=https://open.gasfree.io

# Proxy log verbosity (info|debug|trace). Default `info` drops the Trace/mio/tokio noise;
# bump to debug/trace if you need the firehose. (Rich request/response logging is in nginx.)
PROXY_RUST_LOG=info

# ── Local KDF nodes (throwaway; local-only, not production secrets) ───────────
# Shared RPC password for the two local KDF containers and the proxy's
# kdf_rpc_client. Must match across all three. Any value is fine locally.
KDF_RPC_PASSWORD=local-debug-rpc-pass

# Distinct passphrases => distinct, stable libp2p PeerIds per node.
KDF_PROBE_PASSPHRASE=local-debug-probe-passphrase
KDF_CLIENT_PASSPHRASE=local-debug-client-passphrase

# Client seednodes (comma-separated). KDF requires IPv4 / dotted-DNS, so the
# probe's fixed compose IP (172.28.0.10) is used rather than its service name.
#   "172.28.0.10" -> client meshes directly with the probe => healthcheck true  (no 401)
#   "172.28.0.99" -> a reachable subnet IP with no KDF: client starts but never
#                    meshes with the probe => healthcheck false (401)  <-- prod repro
# NOTE: do NOT use "" — a non-seed node with empty seednodes and p2p enabled
# refuses to start (KDF requires >=1 seednode unless disable_p2p=true).
KDF_CLIENT_SEEDNODES=172.28.0.10

# ── Proxy build pin (usually leave as-is) ────────────────────────────────────
PROXY_REPO=https://github.com/GLEECBTC/komodo-defi-proxy.git
# fix/healthcheck-serialization: GasFree HMAC + healthcheck concurrency fixes +
# wasm32 X-Auth-Payload signature fallback + browser Origin stripping.
PROXY_COMMIT=45c9a06e6a98c611520317933414113480530b60
